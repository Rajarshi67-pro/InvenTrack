# ============================================================
# InvenTrack Pro — Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ── Oracle Database ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=1521
DB_SID=ORCL
DB_USER=inventrack
DB_PASS=InvenTrack@2025
DB_CONNECT_STRING=localhost:1521/ORCL

# ── JWT ────────────────────────────────────────────────────
# IMPORTANT: Use strong random secrets in production!
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=inventrack-access-secret-change-in-production-must-be-64chars-min
JWT_REFRESH_SECRET=inventrack-refresh-secret-change-in-production-must-be-64chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── SMTP (Optional - for email notifications) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@inventrack.com

# ── Oracle Analytics Cloud (Optional) ─────────────────────
OAC_BASE_URL=
OAC_CLIENT_ID=
OAC_CLIENT_SECRET=
OAC_SCOPE=

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
